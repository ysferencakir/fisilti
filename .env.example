SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabanı
# Docker ile çalışıyorsan DB_HOST=db bırak
# Docker olmadan (direkt runserver) çalışıyorsan DB_HOST=localhost yap
DB_NAME=fisilti
DB_USER=fisilti_user
DB_PASSWORD=fisilti_pass
DB_HOST=db
DB_PORT=5432

# E-posta — geliştirme ortamında bu ayarlar kullanılmaz
# settings.py'de EMAIL_BACKEND=console olarak ayarlı, e-postalar terminale yazılır
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fısıltı <your-email@gmail.com>

FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/password-reset

