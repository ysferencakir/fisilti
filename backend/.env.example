# Geliştirme ortamı için bu dosyayı kopyala:
#   cp .env.example .env
# Ardından eksik değerleri doldur.

# ── Django ──────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-degistir-bunu-production-oncesi

# Virgülle ayır, boşluk olmadan
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Veritabanı ──────────────────────────────────────────
# Neon (bulut PostgreSQL) kullanılıyor — bağlantı bilgilerini Yusuf'tan al
DATABASE_URL=postgresql://KULLANICI:SIFRE@HOST/DBADI?sslmode=require

# ── E-posta (Resend SMTP) ────────────────────────────────
# Geliştirmede DEBUG=True iken email doğrulama atlanır.
# Production için Resend panelinden SMTP bilgilerini al: resend.com/settings/smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_BURAYA_RESEND_API_KEY
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fısıltı <noreply@ysferencakir.info.tr>

# Şifre sıfırlama mailinde kullanılacak frontend adresi
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/password-reset

# ── Frontend CORS ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
